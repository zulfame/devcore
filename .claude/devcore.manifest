# Daftar berkas kerangka yang dipasang oleh scripts/sync-devcore.sh
# Format: <jenis> <jalur-target> [<jalur-sumber>]   (jalur-sumber bawaan = jalur-target)
#   managed = ditimpa saat pembaruan, kecuali sudah diubah lokal oleh proyek
#   seed    = disalin sekali bila belum ada; sesudahnya milik proyek dan tidak disentuh lagi
#
# Dipasang dengan logika khusus (tidak ada di daftar ini):
#   .claude/settings.json  digabung (izin dan hook ditambah, hook usang dibuang, pengaturan proyek dipertahankan)
#   CLAUDE.md              hanya ditambah baris impor; isi proyek tidak disentuh
#   .gitignore             hanya ditambah baris yang wajib
# Tidak pernah dipasang ke proyek lain:
#   CLAUDE.local.md README.md CHANGELOG.md VERSION docs/briefs/* docs/adr/* docs/status.md (milik sumber) scripts/test-sync.sh

managed .claude/devcore-rules.md
managed .claude/hooks/pretool-bash-guard.sh
managed .claude/hooks/pretool-brief-gate.sh
managed .claude/hooks/pretool-write-guard.sh
managed .claude/hooks/prompt-rules-reminder.sh
managed .claude/hooks/session-status-loader.sh
managed .claude/hooks/test-hooks.sh
managed .claude/skills/change-function/SKILL.md
managed .claude/skills/check-security/SKILL.md
managed .claude/skills/profile-project/SKILL.md
managed .claude/skills/verify-done/SKILL.md
managed .claude/skills/write-brief/SKILL.md
managed scripts/check-links.sh
managed scripts/check-naming.sh
managed scripts/check-weakened-tests.sh
managed scripts/run-checks.sh
managed scripts/sync-devcore.sh
managed scripts/test-scripts.sh
managed docs/engineering-standard.md
managed docs/enforcement-map.md
managed docs/adopting-devcore.md
managed docs/templates/project-profile.md
managed docs/templates/status.md
managed docs/templates/task-brief.md

seed .claude/devcore.conf
seed .github/workflows/devcore-checks.yml
seed docs/status.md docs/templates/status.md
seed docs/project-profile.md docs/templates/project-profile.md
